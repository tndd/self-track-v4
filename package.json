{
  "name": "self-track-v4",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:mock": "vite --config mock/vite.config.ts",
    "build": "npm run build:app",
    "build:app": "tsc -b && vite build --config app/vite.config.ts",
    "build:mock": "tsc -b && vite build --config mock/vite.config.ts",
    "build:spec": "node scripts/build-spec.mjs",
    "build:pages": "node scripts/clean-pages.mjs && npm run build:app && npm run build:mock && npm run build:spec && node scripts/build-pages-index.mjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config app/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "marked": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  },
  "engines": { "node": ">=22" }
}
